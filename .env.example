# Copiar a .env y ajustar según el entorno (ver Manual de Administrador, 2.4).
# Node (server.js) carga este archivo automáticamente. PHP (api/*.php,
# config/conexion.php) NO lee este archivo directamente: en producción, las
# mismas variables DB_* deben configurarse como variables de entorno reales
# del servidor (ej. hPanel -> Node.js/PHP -> Environment Variables). En
# local, si no están definidas, config/conexion.php usa los valores por
# defecto de XAMPP.

PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=taskmaster_db
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=taskmaster@gmail.com
EMAIL_PASS=tu-app-password

# Variables adicionales que este proyecto necesita y que la plantilla del
# manual no incluye explícitamente:
# - FIREBASE_SERVICE_ACCOUNT_PATH: requerida por lib/firestore.js (server.js).
# - GOOGLE_CLIENT_ID/SECRET y EMAIL_*: reservadas para el backend principal;
#   hoy la autenticación con Google y el envío de correo real están
#   implementados en integraciones/ (ver integraciones/.env.example), que usa
#   sus propias variables (GOOGLE_CLIENT_ID/SECRET, BREVO_*).
FIREBASE_SERVICE_ACCOUNT_PATH=./taskmaster-web-dbcd0-firebase-adminsdk-fbsvc-7ae8ae36dd.json
