# Copia este archivo como ".env" y completa los valores.

# Puerto del servidor Node/Express
PORT=3000

# Ruta al archivo JSON de credenciales de la cuenta de servicio de Firebase.
# Descárgalo desde: Firebase Console → Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
# Por defecto el servidor busca "./serviceAccountKey.json" si no se define esta variable.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
