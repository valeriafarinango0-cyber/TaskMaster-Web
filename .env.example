# Copiar a .env y ajustar según el entorno. Node (server.js) carga este
# archivo automáticamente. PHP (api/*.php, config/conexion.php) NO lee este
# archivo directamente: en producción, las mismas variables DB_* deben
# configurarse como variables de entorno reales del servidor (ej. hPanel ->
# Node.js/PHP -> Environment Variables). En local, si no están definidas,
# config/conexion.php usa los valores por defecto de XAMPP.

PORT=3000
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=taskmaster_db
